{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cartilhas",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "cartilhas.eleotherium.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
